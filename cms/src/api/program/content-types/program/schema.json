{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": { "singularName": "program", "pluralName": "programs", "displayName": "Programas" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "maxLength": 120, "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "shortTitle": { "type": "string", "maxLength": 60 },
    "category": { "type": "enumeration", "enum": ["programa", "campana"], "default": "programa", "required": true },
    "icon": { "type": "customField", "customField": "global::icon" },
    "summary": { "type": "text", "maxLength": 400, "required": true },
    "description": { "type": "text", "maxLength": 2000 },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "videoUrl": { "type": "string", "maxLength": 300 },
    "badge": { "type": "string", "maxLength": 60 },
    "period": { "type": "string", "maxLength": 40 },
    "highlights": { "type": "component", "repeatable": true, "component": "shared.list-item", "max": 3 },
    "keyPoints": { "type": "component", "repeatable": true, "component": "shared.list-item", "max": 8 },
    "faqs": { "type": "component", "repeatable": true, "component": "shared.faq", "max": 10 },
    "order": { "type": "integer", "default": 100, "required": true },
    "showOnHome": { "type": "boolean", "default": false, "required": true },
    "showOnAbout": { "type": "boolean", "default": false, "required": true },
    "showOnProgramsPage": { "type": "boolean", "default": true, "required": true }
  }
}
