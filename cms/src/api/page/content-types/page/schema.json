{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Páginas"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 160
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 70
    },
    "seoDescription": {
      "type": "string",
      "maxLength": 170
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.text-image",
        "blocks.gallery",
        "blocks.faq",
        "blocks.cta"
      ],
      "max": 30
    }
  }
}
