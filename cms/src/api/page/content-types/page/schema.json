{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Páginas nuevas"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 160
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 70
    },
    "seoDescription": {
      "type": "string",
      "maxLength": 170
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.text-image",
        "blocks.gallery",
        "blocks.faq",
        "blocks.cta",
        "sections.hero",
        "home.about",
        "home.process",
        "home.impact",
        "home.programs-intro",
        "home.newsletter",
        "about.history",
        "about.approach",
        "blocks.partners",
        "blocks.steps",
        "blocks.embed",
        "about.intro",
        "about.networks",
        "about.coverage",
        "blocks.programs-detail",
        "blocks.site-cta",
        "blocks.social",
        "blocks.donate"
      ],
      "max": 30
    }
  }
}
