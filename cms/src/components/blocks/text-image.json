{
  "collectionName": "components_blocks_text_images",
  "info": {
    "displayName": "Texto con imagen"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "izquierda",
        "derecha"
      ],
      "default": "derecha",
      "required": true
    },
    "align": {
      "type": "enumeration",
      "enum": [
        "izquierda",
        "centro",
        "justificado"
      ],
      "default": "izquierda"
    },
    "color": {
      "type": "enumeration",
      "enum": [
        "predeterminado",
        "verde",
        "amarillo",
        "rojo",
        "gris"
      ],
      "default": "predeterminado"
    }
  }
}
