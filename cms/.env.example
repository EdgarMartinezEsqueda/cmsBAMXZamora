HOST=127.0.0.1
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
# El proyecto usa MySQL. Usa una base DEDICADA a Strapi, separada de la otra
# plataforma que ya corre en el VPS.
DATABASE_CLIENT=mysql
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
STRAPI_TELEMETRY_DISABLED=true
MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:1337
# Dirección del sitio público: la usan el botón "Vista previa" del panel y el sitemap.xml.
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:1337
TRUST_NGINX_PROXY=false
RESEND_API_KEY=
CONTACT_FROM=
# Turnstile: clave SECRETA del widget cuya clave pública va en el .env raíz (VITE_TURNSTILE_SITE_KEY).
# Si está definida, el servidor exige la verificación; en producción es obligatoria.
TURNSTILE_SECRET_KEY=
# Opcional: rechaza tokens emitidos para otro dominio (p. ej. bamxzamora.org).
TURNSTILE_HOSTNAME=
# Los destinatarios se editan en Configuración de contacto, no aquí.

# Solo para la carga inicial (npm run seed) de "Datos bancarios" en una base nueva. Después se
# editan en el panel (solo administrador). No van en ningún archivo versionado.
SEED_BANK_NAME=
SEED_BANK_CLABE=
SEED_BANK_ACCOUNT=

# Orígenes del sitio que pueden mostrar los PDF de /uploads dentro de su visor (boletines).
# En producción: el dominio público del sitio, p. ej. https://bamxzamora.org
PDF_EMBED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
