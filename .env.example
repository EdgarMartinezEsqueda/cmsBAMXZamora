# Sitio (React/Vite). Todo el contenido sale de Strapi; aquí solo va configuración pública.
# Vite lee este archivo al arrancar: reinicia `npm run dev` después de cambiarlo.

# Dirección de Strapi. En producción puede quedar vacía si Nginx sirve /api en el mismo dominio.
VITE_CMS_URL=http://127.0.0.1:1337

# Cloudflare Turnstile (anti-bots del formulario de contacto): la clave PÚBLICA (site key) del
# mismo widget cuya clave secreta va en cms/.env como TURNSTILE_SECRET_KEY. Sin ella el formulario
# no se muestra y se ofrecen teléfono y correo. En el widget de Cloudflare agrega los dominios
# donde corre el sitio (localhost en desarrollo, el dominio real en producción).
# Para probar sin cuenta: 1x00000000000000000000AA con la secreta 1x0000000000000000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=

# Widget de Instagram (Elfsight) de Inicio.
VITE_InstagramApp=
